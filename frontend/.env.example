# Frontend Environment Variables
# Copy to .env — used by Judge Admin for seed/synthesis tests. Not required for basic courtroom.

# At least one required for Judge Admin (OpenAI and/or Gemini)
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=

# Production: set these when frontend is hosted separately (e.g. GitHub Pages)
# VITE_API_URL=https://your-backend.onrender.com
# VITE_WS_URL=wss://your-backend.onrender.com/ws
