# --- Option A: OpenAI API (cloud) ---
# OPENAI_API_KEY=sk-...

# --- Option B: Local llama-server (run projected_timeline/serve.sh first) ---
# Uncomment below and leave API key as a dummy value:
# OPENAI_API_KEY='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'
# OPENAI_BASE_URL='https://openrouter.ai/api/v1'

# # Local model name served by llama-server (must match --alias in serve.sh)
# LOCAL_MODEL=unsloth/Qwen3.5-35B-A3B
# ONLINE_MODEL='qwen/qwen3.5-122b-a10b'
# # ---------------------------------------------------------------------------
# Multi-model routing (optional — all tiers fall back to LARGE if unset)
# ---------------------------------------------------------------------------
# LARGE tier — counter-arguments, judge intro/interrupts (quality-critical)
# Defaults to LOCAL_MODEL / OPENAI_BASE_URL above.
# MODEL_LARGE=unsloth/Qwen3.5-35B-A3B
# MODEL_LARGE_URL=http://localhost:8001/v1

# SMALL tier — agent analysis, quality scoring, brief summaries (fast)
# Run: projected_timeline/serve-small.sh
# MODEL_SMALL=unsloth/Qwen3-4B
# MODEL_SMALL_URL=http://localhost:8002/v1

# # TINY tier — issue extraction, agenda generation (lightweight structured)
# # Run: projected_timeline/serve-tiny.sh
# MODEL_TINY=gemma-3-1b-it
# MODEL_TINY_URL=http://localhost:8003/v1

# Application Password (if used for specific features)
# PASSWORD=...

# ---------------------------------------------------------------------------
# TTS (text-to-speech) — requires real OpenAI API key, even when running
# LLM inference locally.  If unset, TTS is disabled and agents send text only.
# ---------------------------------------------------------------------------
# TTS_API_KEY=sk-...
# TTS_BASE_URL=https://api.openai.com/v1

# Production Backend URL (for frontend deployment)
# VITE_API_URL=https://your-backend.onrender.com
# VITE_WS_URL=wss://your-backend.onrender.com
# Optional: base URL for static assets hosted on S3/CloudFront
# Example: https://d111111abcdef8.cloudfront.net/court-simulator-assets/
# Optional switch: when true, frontend loads GLB/media from VITE_ASSET_BASE_URL.
# If false or unset, frontend uses local bundled assets.
# VITE_USE_S3_ASSETS=false
# VITE_ASSET_BASE_URL=https://your-cloudfront-domain/your-prefix/
