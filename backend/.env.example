# Backend Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for TTS and Judge Engine)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override OpenAI base URL (for proxies or custom endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Gemini API Key (for alternative LLM)
# GEMINI_API_KEY=your-gemini-api-key

# Optional: ElevenLabs API Key (for alternative TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: Deepgram API Key (for alternative STT)
# DEEPGRAM_API_KEY=your-deepgram-api-key

# Production: allow frontend origin(s), comma-separated (e.g. https://user.github.io,https://court-simulator.pages.dev)
# CORS_ORIGINS=https://your-username.github.io
