# Env secrets — .env.example is committed; never commit .env
.env
/backend/.env
.env.local
.env.*.local
!.env.example

Deploy.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/

# Node
node_modules/

# Build / IDE
dist/
.DS_Store

# Local runtime artifacts
.run/*.log
.run/*.pid

# Accidental root lockfile (frontend uses package-lock.json/bun.lock)
/yarn.lock

# Local source archives not used by runtime app
frontend/src/3d-rendering/Judge/*.zip

# 3D assets served from S3/CloudFront (do not commit binaries)
frontend/src/3d-rendering/glb/*.glb
frontend/src/3d-rendering/glb/**/*.glb

# Multi-agent custom data (user-created, should not be deployed)
backend/multi_agent/data/custom/

# ── LLM model weights ──────────────────────────────────────────────────────
# GGUF binary model files — can be gigabytes each, downloaded at runtime
*.gguf

# Model download directories
backend/projected_timeline/unsloth/
backend/projected_timeline/bartowski/

# ── llama.cpp ──────────────────────────────────────────────────────────────
# Full llama.cpp source tree / build artefacts — checkout separately
backend/projected_timeline/llama.cpp/

# ── Unsloth compiled trainer cache ─────────────────────────────────────────
# Auto-generated by unsloth at import time; never hand-edited
backend/unsloth_compiled_cache/
